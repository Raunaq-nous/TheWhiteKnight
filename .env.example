# Together AI key — get one at https://api.together.ai → API Keys
TOGETHER_API_KEY=your_together_ai_key_here

# Primary model — Kimi K2 (recommended)
# 1T param MoE, 32B active params, built for agentic tasks, 128K context
# Model ID on Together AI: moonshotai/Kimi-K2-Instruct
#
# This is the "drafting" tier ONLY (resume/cover-letter/pitch/outreach
# prose, where reasoning genuinely earns its cost). Every schema-
# constrained task (scoring, JD extraction, requirement mapping, resume
# bullet selection, gap analysis, form answers, company discovery, resume
# audit) defaults to a non-reasoning instruct model instead — a reasoning
# model spending its whole token budget "thinking" before ever emitting the
# required JSON is a real, observed failure mode (content comes back empty,
# finish_reason "length"), not just a cost concern. Override any one of
# them independently if needed: AI_MODEL_SCORING, AI_MODEL_JD_EXTRACTION,
# AI_MODEL_REQUIREMENT_MAP, AI_MODEL_RESUME_SELECTION,
# AI_MODEL_PROFILE_EXTRACTION, AI_MODEL_GAP_ANALYSIS, AI_MODEL_FORM_ANSWERS,
# AI_MODEL_COMPANY_DISCOVERY, AI_MODEL_AUDIT — all default to
# meta-llama/Llama-3.3-70B-Instruct-Turbo, uncomment only to change one.
AI_MODEL=deepseek-ai/DeepSeek-V4-Pro
# AI_MODEL_SCORING=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Vision model for JD image/screenshot extraction (must support multimodal input)
AI_VISION_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# Auth — Upstash Redis (provision at vercel.com → Integrations → Upstash → Redis)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Session JWT signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_32_random_chars

# One-time admin setup secret — used once to seed Raunaq's account, then remove
SETUP_SECRET=replace_with_secret

# Admin email — used by /api/admin/setup to create the admin account
ADMIN_EMAIL=
