# Together AI key — get one at https://api.together.ai → API Keys
TOGETHER_API_KEY=your_together_ai_key_here

# Primary model — Kimi K2 (recommended)
# 1T param MoE, 32B active params, built for agentic tasks, 128K context
# Model ID on Together AI: moonshotai/Kimi-K2-Instruct
AI_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Vision model for JD image/screenshot extraction (must support multimodal input)
AI_VISION_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# Auth — Upstash Redis (provision at vercel.com → Integrations → Upstash → Redis)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Session JWT signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_32_random_chars

# One-time admin setup secret — used once to seed Raunaq's account, then remove
SETUP_SECRET=replace_with_secret
