# ─── Portkey gateway ─────────────────────────────────────────────────────────
# Get a Portkey key at https://app.portkey.ai
PORTKEY_API_KEY=your_portkey_api_key_here

# ─── Provider routing: choose ONE of the two approaches below ────────────────

# APPROACH A — Virtual key (recommended)
# Create a virtual key in the Portkey dashboard pointing to your provider.
# If set, this overrides everything else.
PORTKEY_VIRTUAL_KEY=

# APPROACH B — Direct provider routing (used when PORTKEY_VIRTUAL_KEY is blank)
# Provider: together-ai | groq | fireworks-ai | openai | anthropic
AI_PROVIDER=together-ai
# Your API key for that provider
AI_PROVIDER_KEY=your_together_ai_key_here

# ─── Model selection ─────────────────────────────────────────────────────────
# Recommended open-source models (Opus-class reasoning):
#
#   deepseek-ai/DeepSeek-V3             ← best overall (Together AI / Fireworks)
#   meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8  ← best structured output
#   Qwen/Qwen3-235B-A22B               ← strong reasoning, 235B MoE
#
# Via Groq (faster, good quality):
#   deepseek-r1-distill-llama-70b
#   llama-4-maverick-17b-128e-instruct

AI_MODEL=deepseek-ai/DeepSeek-V3

# Vision model for JD image/screenshot extraction (needs multimodal support)
# Llama 4 Maverick on Together AI supports vision
AI_VISION_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
